{
    "name": "pickle-glass",
    "productName": "HintsyAI",
    "version": "0.2.4",
    "description": "Cl*ely for Free",
    "main": "src/index.js",
    "scripts": {
        "setup": "npm install && cd pickleglass_web && npm install && npm run build && cd .. && npm start",
        "start": "npm run build:renderer && electron .",
        "dev": "npm run start:web:dev",
        "start:web:dev": "concurrently \"cd pickleglass_web && npm run dev\" \"wait-on http://localhost:3000 && npm run build:renderer && electron .\" --kill-others --success first",
        "start:web:prod": "concurrently \"cd pickleglass_web && npm run build && npm start\" \"wait-on http://localhost:3000 && npm run build:renderer && electron .\" --kill-others --success first",
        "package": "npm run build:all && electron-builder --dir",
        "make": "npm run build:renderer && electron-forge make",
        "build": "npm run build:all && electron-builder --config electron-builder.yml --publish never",
        "build:unsigned": "npm run build:all && electron-builder --publish never",
        "build:win": "npm run build:all && electron-builder --win --x64 --publish never",
        "publish": "npm run build:all && electron-builder --config electron-builder.yml --publish always",
        "lint": "eslint --ext .ts,.tsx,.js .",
        "postinstall": "electron-builder install-app-deps && npx @electron/rebuild",
        "build:renderer": "node build.js",
        "build:web": "cd pickleglass_web && npm run build && cd ..",
        "build:all": "npm run build:renderer && npm run build:web",
        "watch:renderer": "node build.js --watch"
    },
    "keywords": [
        "glass",
        "pickle glass",
        "ai assistant",
        "real-time",
        "live summary",
        "contextual ai"
    ],
    "author": {
        "name": "Pickle Team"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.56.0",
        "@deepgram/sdk": "^4.9.1",
        "@emnapi/runtime": "^1.4.5",
        "@google/genai": "^1.8.0",
        "@google/generative-ai": "^0.24.1",
        "axios": "^1.10.0",
        "better-sqlite3": "^9.6.0",
        "cors": "^2.8.5",
        "dotenv": "^17.0.0",
        "electron-squirrel-startup": "^1.0.1",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.6.2",
        "express": "^4.18.2",
        "firebase": "^11.10.0",
        "firebase-admin": "^13.4.0",
        "groq-sdk": "^0.30.0",
        "jsonwebtoken": "^9.0.2",
        "keytar": "^7.9.0",
        "node-fetch": "^2.7.0",
        "openai": "^4.70.0",
        "portkey-ai": "^1.10.1",
        "react-hot-toast": "^2.5.2",
        "sharp": "^0.34.3",
        "validator": "^13.11.0",
        "wait-on": "^8.0.3",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@electron/fuses": "^1.8.0",
        "@electron/notarize": "^2.5.0",
        "@electron/rebuild": "^3.7.2",
        "concurrently": "^8.2.2",
        "electron": "^30.5.1",
        "electron-builder": "^26.0.12",
        "electron-rebuild": "^3.2.9",
        "electron-reloader": "^1.2.3",
        "esbuild": "^0.25.5",
        "prettier": "^3.6.2"
    },
    "optionalDependencies": {
        "electron-liquid-glass": "^1.0.1"
    }
}
