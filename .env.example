# HintsyAI Environment Configuration

# Web Application URL
# For development: http://localhost:3000
# For production: https://your-deployment-domain.com
Hintsy_AI_URL=http://localhost:3000

# API Server URL  
# For development: http://localhost:9001
# For production: https://your-api-domain.com
pickleglass_API_URL=http://localhost:9001

# Other optional configurations
# pickleglass_API_TIMEOUT=10000
# pickleglass_DEBUG=true
# pickleglass_LOG_LEVEL=debug
